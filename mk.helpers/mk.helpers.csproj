<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Description>A comprehensive collection of utility and extension methods designed to enhance your .NET development experience. With a wide array of helper methods, this library aims to simplify various tasks and processes, making your development journey a breeze.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<Version>1.4.0</Version>
		<PackageReleaseNotes>
			- New: NumberExtensions (invariant ToFloat/ToInt/ToDouble, ToFloats/ToInts, ToInvariant), PathHelper (IsInside, SafeCombine, FindUp, ToForwardSlashes, ShortHash), FixedQueue, HttpListenerExtensions and LocalHttp for small localhost servers, JsonNodeExtensions (ParseJsonObject, HasJsonComments, DeepMerge and more), CommandArgs (Windows-safe Split/Join), AnsiExtensions.StripAnsi, SerialQueue, MathExtensions (Approach, Wrap).
			- Added: string dictionary GetFloat/GetInt/GetBool/GetFloats and SameAs, StringExtensions Words/StripComment, FileHelper WriteAllTextAtomic/ReadAllTextWithRetry, TimeSpan ToClock/SecondsToClock, IpHelper.IsPortOpenAsync.
		</PackageReleaseNotes>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<RepositoryUrl>https://github.com/mcknight89/mk.helpers</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
		<PackageReference Include="System.Text.Json" Version="8.0.5" />

	</ItemGroup>

</Project>